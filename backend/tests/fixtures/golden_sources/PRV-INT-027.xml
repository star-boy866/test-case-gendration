	<queries><query name="q_PRV_INT_027"><source><sqlQuery name="SQL1" dataSource="OLTP_NH"><sqlText>select
&quot;P_RPT_CLDI_TERM_TB&quot;.P_CLDI_TERM_SK &quot;Prov SK&quot;,
&quot;P_RPT_CLDI_TERM_TB&quot;.P_CURR_ALT_ID &quot;Prov ID&quot;,
&quot;P_RPT_CLDI_TERM_TB&quot;.P_SORT_NAM &quot;Prov Sort Name&quot;,
&quot;P_RPT_CLDI_TERM_TB&quot;.P_LIC_CERT_NUM &quot;Prov Lic Cert Num&quot;,
&quot;P_RPT_CLDI_TERM_TB&quot;.P_CMN_LIC_CERT_END_DT &quot;OPLC Term Date&quot;,
&quot;P_RPT_CLDI_TERM_TB&quot;.P_MMIS_LIC_CERT_END_DT &quot;MMIS Lic Cert End Date&quot;,
&quot;P_RPT_CLDI_TERM_TB&quot;.G_RPT_PRCS_DT &quot;MM/DD/CCYY&quot;,
&quot;P_RPT_CLDI_TERM_TB&quot;.G_FILE_NAM &quot;File Name&quot;,
COALESCE(
            CASE 
                WHEN 
                    &quot;P_RPT_CLDI_TERM_TB&quot;.&quot;P_REVLDTN_STAT_CD&quot; IS NULL OR
                    &quot;R_VV_TB&quot;.&quot;R_VV_LONG_DESC&quot; IS NULL
                    THEN
                        NULL
                ELSE &quot;P_RPT_CLDI_TERM_TB&quot;.&quot;P_REVLDTN_STAT_CD&quot; || &apos;-&apos; || &quot;R_VV_TB&quot;.&quot;R_VV_LONG_DESC&quot;
            END, 
            &quot;P_RPT_CLDI_TERM_TB&quot;.&quot;P_REVLDTN_STAT_CD&quot;) &quot;Reval Stat Cd&quot;,
&quot;P_RPT_CLDI_TERM_TB&quot;.P_LAST_REVLDTN_STAT_DT &quot;Last Reval Status Dt&quot;
FROM P_RPT_CLDI_TERM_TB &quot;P_RPT_CLDI_TERM_TB&quot;
LEFT OUTER JOIN &quot;R_VV_TB&quot; &quot;R_VV_TB&quot;
            ON 
                &quot;P_RPT_CLDI_TERM_TB&quot;.&quot;P_REVLDTN_STAT_CD&quot; = &quot;R_VV_TB&quot;.&quot;R_VV_CD&quot; AND
                &quot;R_VV_TB&quot;.&quot;R_VV_DOMAIN_NAM&quot; = &apos;P_REVLDTN_STAT_CD&apos;</sqlText><mdProjectedItems><mdProjectedItem name="Prov SK"/><mdProjectedItem name="Prov ID"/><mdProjectedItem name="Prov Sort Name"/><mdProjectedItem name="Prov Lic Cert Num"/><mdProjectedItem name="OPLC Term Date"/><mdProjectedItem name="MMIS Lic Cert End Date"/><mdProjectedItem name="MM/DD/CCYY"/><mdProjectedItem name="File Name"/><mdProjectedItem name="Reval Stat Cd"/><mdProjectedItem name="Last Reval Status Dt"/></mdProjectedItems></sqlQuery></source><selection><dataItem name="EvenOdd"><expression>mod(running-count([Value1]),2)</expression></dataItem><dataItem aggregate="none" name="Value1" rollupAggregate="none"><expression>1</expression></dataItem><dataItem name="Prov SK"><expression>[SQL1].[Prov SK]</expression></dataItem><dataItem name="Prov ID" label="Prov ID"><expression>[SQL1].[Prov ID]</expression></dataItem><dataItem name="Prov Sort Name" label="Prov Sort Name"><expression>[SQL1].[Prov Sort Name]</expression></dataItem><dataItem name="Prov Lic Cert Num" label="Prov Lic Cert Num"><expression>[SQL1].[Prov Lic Cert Num]</expression></dataItem><dataItem name="OPLC Term Date" label="OPLC Term Date"><expression>[SQL1].[OPLC Term Date]</expression></dataItem><dataItem name="MMIS Lic Cert End Date" label="MMIS Lic Cert End Date"><expression>[SQL1].[MMIS Lic Cert End Date]</expression></dataItem><dataItem name="MM/DD/CCYY"><expression>[SQL1].[MM/DD/CCYY]</expression></dataItem><dataItem name="File Name"><expression>[SQL1].[File Name]</expression></dataItem><dataItem name="Reval Stat Cd" label="Reval Status CD"><expression>[SQL1].[Reval Stat Cd]</expression></dataItem><dataItem name="Last Reval Status Dt" label="Last Reval Status Dt"><expression>[SQL1].[Last Reval Status Dt]</expression></dataItem><dataItem name="Total Errors"><expression>count([Prov SK] for report)</expression></dataItem></selection><queryHints><localCache value="false"/></queryHints></query><query na