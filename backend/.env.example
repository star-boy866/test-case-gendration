# Copy this file to .env and fill in real values. Never commit .env.
# Every value below has a working default in app/core/config.py — this
# file only needs entries for what you want to OVERRIDE.

APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

ALLOWED_ORIGINS=http://localhost:5173

SQLITE_DB_PATH=./database/app_metadata.db

# --- LLM (Phase 4/5) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=60
MAX_SCENARIOS_PER_REQUEST=6
MAX_REFLECTION_ITERATIONS=2
MIN_CACHEABLE_QUALITY_SCORE=0.75

# --- Vector store / semantic cache (Phase 3) ---
FAISS_INDEX_PATH=./database/faiss_index
CACHE_HIT_THRESHOLD=0.15
CACHE_PARTIAL_HIT_THRESHOLD=0.30
EMBEDDING_DIM=256

# --- File storage ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50
EXPORT_DIR=./exports

# --- Phase 8: SharePoint sync (Microsoft Graph API, app-only auth) ---
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_URL=
SHAREPOINT_UPLOAD_FOLDER=SIT-QA-Exports

# --- Phase 8: email notifications (any standard SMTP server) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=
EMAIL_TIMEOUT_SECONDS=20

# --- Phase 9: auth / JWT ---
# REPLACE for any deployment beyond your own laptop — this is what signs
# every access token. python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-only-change-me
ACCESS_TOKEN_EXPIRES_SECONDS=28800

# --- Phase 9: AES-256-GCM encryption at rest ---
# Base64-encoded 32-byte key. Deliberately has NO working default — see
# app/core/encryption.py's docstring. Generate one with:
#   python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

# --- Phase 9: malware scanning ---
# ClamAV (clamd) is optional — structural file validation always runs
# regardless of this being set. Leave empty to skip the ClamAV tier.
CLAMD_HOST=
CLAMD_PORT=3310
CLAMD_TIMEOUT_SECONDS=10

AUDIT_LOG_PATH=./database/audit_log.db
